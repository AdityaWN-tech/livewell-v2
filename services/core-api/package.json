{
  "name": "livewell-core-api",
  "private": true,
  "type": "module",
  "description": "Core API and Firestore triggers (TypeScript, Cloud Functions 2nd gen). Spec 10.2.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run bundle-scripts && tsc",
    "typecheck": "npm run bundle-scripts && tsc --noEmit",
    "test": "npm run build && firebase emulators:exec --only auth,firestore,functions,storage --project demo-livewell \"vitest run\"",
    "bundle-scripts": "node scripts/bundle-scripts.mjs",
    "migrate:user-arrays": "npm run build && node lib/migrations/user-arrays-cli.js"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "firebase-tools": "^15.33.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
