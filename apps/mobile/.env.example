# Build-time values for the mobile app, passed with --dart-define (never commit
# real values; keep them in Secret Manager / CI secrets).

# Travel Mode nearby places (FR-TRV-03, D-86): Google Places API (New) key,
# restricted to the app's Android package / iOS bundle id. Empty = no in-app
# listings; the app offers a search in the phone's maps app instead.
LW_PLACES_API_KEY=

# Dev only: Media Service on the developer's computer (D-64).
LW_MEDIA_URL=

# Where people ask for a copy of their data (D-56). Empty = no export row.
LW_DATA_REQUEST_EMAIL=
