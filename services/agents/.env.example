# Copy to .env (git-ignored) for local runs. Never commit a real key.
# The service reads these from the environment; load them with e.g.
#   set -a; . ./.env; set +a          (bash)
# On Cloud Run the key comes from Secret Manager:
#   --set-secrets ANTHROPIC_API_KEY=anthropic-dev-key:latest

AGENTS_ENV=dev
# fake = deterministic FakeModelClient (no network); anthropic = real Claude.
AGENTS_MODEL_PROVIDER=fake
# Dev key with zero data retention (D-90). Leave empty until the owner sets it.
ANTHROPIC_API_KEY=
LW_ANTHROPIC_MODEL=claude-opus-5-5
LW_ANTHROPIC_EFFORT=low
# Safety classifier (T-AGT-02): same model, effort low, its own limits.
LW_SAFETY_CLASSIFIER_MAX_TOKENS=4000
LW_SAFETY_CLASSIFIER_TIMEOUT_S=15
# Local only: accept 'token-<uid>' / 'app-check-ok' for the synthetic users.
LW_DEV_FAKE_AUTH=1
# Print redacted spans to stdout.
LW_OTEL_CONSOLE=0
# Opt-in live eval against the real API (costs money): pytest -m live evals/live
LW_LIVE_EVALS=0
