rules_version = '2';

// Live Well v2 Firestore security rules (spec Section 11 / 11.1, T-FND-06).
// HUMAN REVIEW REQUIRED (security). Tests: firebase/test/*.test.ts (npm test).
//
// Principles:
// - A user reads and writes only their own users/{uid}/** documents.
// - Server-only fields and documents (vendor ids, safety state, plan tier,
//   voice status, portal links, daily plans, coach messages, streaks) are
//   written by Cloud Functions / Admin SDK, which bypass these rules.
// - Nothing is stored for anyone who hasn't confirmed they are 18+ (FR-ONB-04).
// - Append-only where the spec says so (consents, portal events).
// - Everything not matched below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // The profile exists and the 18+ age gate was passed.
    function isAdultOwner(uid) {
      return isOwner(uid)
        && exists(userDoc(uid))
        && get(userDoc(uid)).data.age_confirmed == true;
    }

    // Spec 11: every document carries created_at, updated_at, schema_version.
    function hasMeta(data) {
      return data.created_at is timestamp
        && data.updated_at is timestamp
        && data.schema_version is int;
    }

    // Only these keys changed in this update.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isScore(v) {
      return v is int && v >= 1 && v <= 5;
    }

    // ---------- users/{uid} (root profile) ----------

    match /users/{uid} {
      // Fields the app may write. Not listed = server-only
      // (plan_tier, ed_safe_mode, safety state, anything else).
      function clientProfileKeys() {
        return ['display_name', 'email', 'tz', 'locale', 'region',
                'age_confirmed', 'onboarding_step', 'focus_driver',
                'focus_choices', 'activity_limited', 'touchpoints',
                'coach_name', 'appearance', 'quiet_hours',
                'notification_categories',
                'why_statement', 'created_at', 'updated_at', 'schema_version'];
      }

      // "What would you like to work on this week?" (T-ONB-03d): 1 or 2 of
      // the fixed choices; activity_limited from the FR-GOL-03 check.
      function validFocus(d) {
        return (!('focus_choices' in d)
                || (d.focus_choices is list
                    && d.focus_choices.size() >= 1
                    && d.focus_choices.size() <= 2
                    && d.focus_choices.hasOnly(['move_more', 'sleep_better',
                         'eat_better', 'less_stress', 'more_energy',
                         'healthy_routine'])))
          && (!('focus_driver' in d)
              || (d.focus_driver is string && d.focus_driver.size() <= 40))
          && (!('activity_limited' in d) || d.activity_limited is bool)
          && (!('touchpoints' in d) || validTouchpoints(d.touchpoints))
          && validSettings(d);
      }

      // Profile settings (T-ONB-03f, FR-SET-01): kept on the profile so they
      // follow the person across devices.
      function hhmm(v) {
        return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }
      function validSettings(d) {
        return (!('coach_name' in d)
                || (d.coach_name is string && d.coach_name.size() >= 1
                    && d.coach_name.size() <= 20))
          && (!('appearance' in d)
              || (d.appearance is map
                  && d.appearance.keys().hasOnly(['theme', 'text_scale'])
                  && d.appearance.theme in ['system', 'light', 'dark']
                  && d.appearance.text_scale in [1.0, 1.15, 1.3]))
          && (!('quiet_hours' in d)
              || (d.quiet_hours is map
                  && d.quiet_hours.keys().hasOnly(['start', 'end'])
                  && hhmm(d.quiet_hours.start) && hhmm(d.quiet_hours.end)))
          && (!('notification_categories' in d)
              || (d.notification_categories is map
                  && d.notification_categories.keys()
                       .hasOnly(['greeting', 'nudge', 'reflection'])
                  && d.notification_categories.greeting is bool
                  && d.notification_categories.nudge is bool
                  && d.notification_categories.reflection is bool));
      }

      // Morning / midday / evening touchpoint times, "HH:MM" (T-ONB-03e).
      function validTouchpoints(t) {
        return t is map
          && t.keys().hasOnly(['morning', 'midday', 'evening'])
          && t.morning.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && t.midday.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && t.evening.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }

      // The personal Why (FR-ONB-05) is short free text.
      function validWhy(d) {
        return !('why_statement' in d)
          || (d.why_statement is string && d.why_statement.size() <= 280);
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(clientProfileKeys())
        && request.resource.data.age_confirmed == true
        && validWhy(request.resource.data)
        && validFocus(request.resource.data)
        && hasMeta(request.resource.data);
      allow update: if isOwner(uid)
        && onlyChanges(clientProfileKeys())
        && request.resource.data.age_confirmed == true
        && validWhy(request.resource.data)
        && validFocus(request.resource.data)
        && request.resource.data.updated_at is timestamp;
      // Account deletion runs on the server (FR-SET-02).
      allow delete: if false;

      // ---------- consents: append-only (FR-ONB-02/03) ----------
      match /consents/{consentId} {
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['type', 'doc_version', 'granted', 'granted_at', 'revoked_at',
                'app_version', 'evidence_ref', 'created_at', 'updated_at',
                'schema_version'])
          && request.resource.data.type is string
          && request.resource.data.doc_version is string
          && request.resource.data.granted is bool
          && request.resource.data.app_version is string
          && request.resource.data.created_at == request.time
          && hasMeta(request.resource.data);
        // Never overwrite or delete: a revocation is a new record.
        allow update, delete: if false;
      }

      // ---------- avatar: the coach the person picks; made-for-you sets server-only ----------
      // T-AVT-08b: the app writes a ready-made coach (`source: default`,
      // `coach_id`), the coach's name and the background. Selfie and built
      // avatars, `frames_version`, vendor ids and thumbnails are written by
      // the Media Service (T-AVT-08c/d). Older cartoon docs keep `style_config`.
      match /avatar/{docId} {
        function clientAvatarKeys() {
          return ['type', 'style_config', 'raw_media_retained',
                  'created_at', 'updated_at', 'schema_version',
                  'source', 'coach_id', 'coach_name', 'background'];
        }
        function readyCoaches() {
          return ['brown_hair', 'long_black_hair', 'green_hijab', 'navy_turban',
                  'grey_glasses', 'short_curls', 'short_black_hair', 'wheelchair'];
        }
        function validAvatar(d) {
          return d.type in ['stylized', 'photoreal', '3d_adult']
            && d.get('raw_media_retained', false) == false
            && (d.type != '3d_adult'
                || (d.get('source', '') in ['default', 'selfie', 'built']
                    && d.get('coach_id', 'brown_hair') in readyCoaches()))
            && (!('coach_name' in d)
                || (d.coach_name is string
                    && d.coach_name.size() >= 1 && d.coach_name.size() <= 20))
            && (!('background' in d)
                || (d.background is int && d.background >= 0 && d.background <= 5));
        }
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid) && docId == 'current'
          && request.resource.data.keys().hasOnly(clientAvatarKeys())
          && validAvatar(request.resource.data)
          // Only a ready-made coach is made on the phone.
          && request.resource.data.get('source', 'default') == 'default'
          && hasMeta(request.resource.data);
        allow update: if isAdultOwner(uid) && docId == 'current'
          && onlyChanges(['type', 'style_config', 'raw_media_retained', 'updated_at',
                          'source', 'coach_id', 'coach_name', 'background'])
          && validAvatar(request.resource.data)
          // The app may go back to a ready-made coach, never claim a
          // made-for-you one.
          && (request.resource.data.get('source', 'default')
                == resource.data.get('source', 'default')
              || request.resource.data.get('source', 'default') == 'default');
        allow delete: if false; // "Delete my avatar" runs on the server (FR-SET-03)
      }

      // ---------- voices: status and vendor ids are server-only (16.2) ----------
      match /voices/{voiceId} {
        function validSpeed(d) {
          return d.speed is number && d.speed >= 0.8 && d.speed <= 1.2;
        }
        // A library voice (T-ONB-03c): no personal data, chosen in the app.
        // Id = the app's catalogue id; only fixed fields.
        function validLibraryVoice(d) {
          return d.keys().hasOnly(['kind', 'vendor_voice_id', 'status',
                   'speed', 'style', 'created_at', 'updated_at',
                   'schema_version'])
            && d.kind == 'library'
            && voiceId.matches('^lw-[a-z0-9-]{1,30}$')
            && d.vendor_voice_id is string
            && d.status in ['active', 'inactive']
            && validSpeed(d)
            && d.style in ['calm', 'energetic'];
        }
        allow read: if isOwner(uid);
        // Cloned voices (self, loved one, Dr. Gokula) are created only by
        // the server after the consent flow (spec 7.4, 16.2).
        allow create: if isAdultOwner(uid)
          && validLibraryVoice(request.resource.data)
          && hasMeta(request.resource.data);
        // Any voice: playback preferences. Library voices: also switching
        // which one is active. Status of cloned voices stays server-only.
        allow update: if isAdultOwner(uid)
          && validSpeed(request.resource.data)
          && (onlyChanges(['speed', 'style', 'updated_at'])
              || (resource.data.kind == 'library'
                  && onlyChanges(['status', 'speed', 'style', 'updated_at'])
                  && request.resource.data.status in ['active', 'inactive']));
        allow delete: if false;
      }

      // ---------- assessments: saveable until completed (FR-ONB-06) ----------
      match /assessments/{assessmentId} {
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid)
          && request.resource.data.bank_version is string
          && hasMeta(request.resource.data);
        allow update: if isAdultOwner(uid)
          && resource.data.get('completed_at', null) == null
          && request.resource.data.bank_version == resource.data.bank_version;
        allow delete: if false;
      }

      // ---------- goals and habits (FR-GOL) ----------
      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid) && hasMeta(request.resource.data);
        allow update: if isAdultOwner(uid);
        allow delete: if false; // pause instead (FR-GOL-02)
      }

      match /habits/{habitId} {
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid)
          && request.resource.data.title is string
          && hasMeta(request.resource.data);
        allow update: if isAdultOwner(uid);
        allow delete: if false;
      }

      // ---------- habit logs: idempotent id date_habitId (11, NFR-05) ----------
      match /habit_logs/{logId} {
        function validLog(d) {
          return logId == d.date + '_' + d.habit_id
            && d.status in ['done', 'skipped', 'partial']
            && d.source in ['app', 'widget', 'watch', 'auto'];
        }
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid)
          && validLog(request.resource.data)
          && hasMeta(request.resource.data);
        allow update: if isAdultOwner(uid)
          && validLog(request.resource.data)
          && request.resource.data.date == resource.data.date
          && request.resource.data.habit_id == resource.data.habit_id;
        allow delete: if false;
      }

      // ---------- check-ins: one per date (FR-DLY-02) ----------
      // Mood first (T-DLY-02): mood required, the rest optional.
      match /checkins/{date} {
        function optionalScore(d, key) {
          return !(key in d) || isScore(d[key]);
        }
        function validCheckin(d) {
          return d.keys().hasOnly(['mood', 'energy', 'sleep', 'stress',
                   'time_available', 'barrier_text', 'source', 'gentle_day',
                   'created_at', 'updated_at', 'schema_version'])
            && isScore(d.mood)
            && optionalScore(d, 'energy')
            && optionalScore(d, 'sleep')
            && optionalScore(d, 'stress')
            && (!('time_available' in d) || d.time_available in [2, 5, 10, 30])
            && (!('barrier_text' in d)
                || (d.barrier_text is string && d.barrier_text.size() <= 140))
            && d.source in ['app', 'widget', 'watch']
            && d.gentle_day is bool
            // Safety floor (spec 15.3): low mood or high stress is always a
            // gentle day, so no portal card can appear that day.
            && (d.gentle_day == true
                || (d.mood > 2 && (!('stress' in d) || d.stress < 4)));
        }
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validCheckin(request.resource.data)
          && hasMeta(request.resource.data);
        // Same-day re-submit updates the record; created_at never changes.
        allow update: if isAdultOwner(uid)
          && validCheckin(request.resource.data)
          && request.resource.data.created_at == resource.data.created_at
          && request.resource.data.updated_at is timestamp;
        allow delete: if false;
      }

      // ---------- evening reflection, one per local date (FR-DLY-05, T-UI-01d) ----------
      // The app runs the text through the red-flag rules before saving;
      // emergency, crisis and disordered-eating text is never sent.
      match /reflections/{date} {
        function validReflection(d) {
          return d.keys().hasOnly(['text', 'prompt', 'source', 'created_at',
                   'updated_at', 'schema_version'])
            && d.text is string && d.text.size() > 0 && d.text.size() <= 500
            && d.prompt in ['went_well']
            && d.source in ['app'];
        }
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validReflection(request.resource.data)
          && hasMeta(request.resource.data);
        // Same-day edit; created_at never changes.
        allow update: if isAdultOwner(uid)
          && validReflection(request.resource.data)
          && request.resource.data.created_at == resource.data.created_at
          && request.resource.data.updated_at is timestamp;
        allow delete: if false;
      }

      // ---------- memory facts: user approves or deletes (FR-CNV-05) ----------
      match /memory_facts/{factId} {
        allow read: if isOwner(uid);
        // Facts are proposed by the Memory Agent (server); the user only
        // changes their status. A deleted fact can't be brought back.
        allow update: if isAdultOwner(uid)
          && onlyChanges(['status', 'updated_at'])
          && resource.data.status != 'deleted'
          && request.resource.data.status in ['saved', 'deleted'];
        allow create, delete: if false;
      }

      // ---------- portal events: app-side events only, append-only (13.2) ----------
      match /portal_events/{eventId} {
        allow read: if isOwner(uid);
        // order / progress / completed come only from TagMango webhooks (server).
        allow create: if isAdultOwner(uid)
          && request.resource.data.event in ['card_shown', 'clicked', 'dismissed']
          && request.resource.data.offer_id is string
          && hasMeta(request.resource.data);
        allow update, delete: if false;
      }

      // ---------- server-written, read-only for the app ----------
      // Daily plans are written by the nightly job, except the rule-based
      // 7-day starter plan (T-ONB-03e), which the app writes itself. The app
      // can never overwrite a plan the server wrote.
      match /daily_plans/{date} {
        function validStep(s) {
          return s is map
            && s.keys().hasOnly(['title', 'reason', 'anchor', 'minutes',
                 'smaller_title', 'smaller_minutes', 'focus'])
            && s.title is string && s.title.size() <= 160
            && s.minutes in [2, 5, 10, 30];
        }
        function validStarterDay(d) {
          return d.keys().hasOnly(['next_step', 'alternatives', 'supporting',
                   'mode', 'day_number', 'source', 'template_version',
                   'created_at', 'updated_at', 'schema_version'])
            && d.source == 'starter_v1'
            && validStep(d.next_step)
            && d.alternatives is list && d.alternatives.size() <= 2
            && d.supporting is list && d.supporting.size() <= 2
            && d.mode in ['normal', 'gentle']
            && d.day_number is int && d.day_number >= 1 && d.day_number <= 7;
        }
        allow read: if isOwner(uid);
        allow create: if isAdultOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validStarterDay(request.resource.data)
          && hasMeta(request.resource.data);
        allow update: if isAdultOwner(uid)
          && resource.data.source == 'starter_v1'
          && validStarterDay(request.resource.data)
          && request.resource.data.updated_at is timestamp;
        allow delete: if false;
      }
      match /messages/{messageId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /streaks/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /portal_link/{docId} {
        allow read: if isOwner(uid);
        allow write: if false; // linking and unlinking run on the server (FR-SET-04)
      }
    }

    // ---------- global catalogues: read-only, approved items only ----------
    // Rules are not filters: app queries must include these same conditions.
    match /portal_offers/{offerId} {
      allow read: if signedIn()
        && resource.data.active == true
        && resource.data.review_status == 'approved';
      allow write: if false;
    }

    match /content_items/{itemId} {
      allow read: if signedIn() && resource.data.review_status == 'approved';
      allow write: if false;
    }

    // ---------- server-only, never readable by clients (11.1) ----------
    match /voice_consents/{id} {
      allow read, write: if false;
    }
    match /safety_events/{id} {
      allow read, write: if false;
    }
    match /audit_log/{id} {
      allow read, write: if false;
    }

    // Anything else: denied by default (no other match blocks).
  }
}
