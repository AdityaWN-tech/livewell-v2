  "rules": [
    {
      "id": "EM-CHEST",
      "category": "emergency",
      "spec": "FR-SAF-01",
      "patterns": [
        "\\bchest (?:pain|pains|pressure|tightness|is tight|feels tight|hurts|is hurting|squeezing|crushing)\\b",
        "\\b(?:crushing|squeezing|severe|sharp|bad) chest\\b",
        "\\b(?:pain|pressure|tightness) in (?:my|the) chest\\b",
        "\\b(?:pains?|pressure|tight|tightness|squeez\\w*|crush\\w*|heaviness|burning|stabbing|aching)(?: [a-z']+){0,3} (?:in|on|across|around|of) (?:my|the|his|her) chest\\b",
        "\\b(?:heavy |a )?(?:weight|heaviness) (?:on|in) (?:my|the|his|her) chest\\b",
        "\\bheavy (?:feeling|sensation) (?:on|in) (?:my|the|his|her) chest\\b",
        "\\b(?:having|have) a heart attack\\b",
        "\\b(?:think|thinks|might be|could be|is this) (?:it'?s |i'?m having )?a heart attack\\b"
      ]
    },
    {
      "id": "EM-STROKE",
      "category": "emergency",
      "spec": "FR-SAF-01",
      "patterns": [
        "\\b(?:having|have) a stroke\\b",
        "\\bsigns? of (?:a )?stroke\\b",
        "\\b(?:face|mouth) (?:is )?(?:drooping|droopy|droops)\\b",
        "\\bdrooping (?:face|mouth)\\b",
        "\\b(?:half|one side|side|left side|right side) (?:of )?(?:my|his|her) face (?:is |went |has gone |feels |suddenly |just )*(?:numb|droop\\w*|dead|weak|paraly[sz]ed|frozen)\\b",
        "\\b(?:ca(?:n ?'?t|not)|unable to) smile (?:properly|normally|on one side|straight)\\b",
        "\\bslurr(?:ed|ing) (?:speech|words)\\b",
        "\\bsudden(?:ly)? (?:i )?(?:ca(?:n ?'?t|not)|unable to) (?:speak|talk)\\b",
        "\\b(?:ca(?:n ?'?t|not)|unable to) (?:speak|talk) (?:properly|clearly|normally)\\b",
        "\\b(?:trouble|difficulty|problems?) (?:speaking|talking)\\b",
        "\\b(?:ca(?:n ?'?t|not)|unable to) (?:lift|move) my (?:arm|leg)\\b",
        "\\bsudden(?:ly)? (?:numb|numbness|weak|weakness|confused|confusion|blind)\\b",
        "\\b(?:left|right) (?:arm|side|leg) (?:is |went |has gone |feels )?(?:numb|weak|dead)\\b"
      ]
    },
    {
      "id": "EM-BREATH",
      "category": "emergency",
      "spec": "FR-SAF-01",
      "patterns": [
        "\\b(?:ca(?:n ?'?t|not)|unable to|struggling to|hard to|barely) breathe?\\b",
        "\\b(?:severe|extreme|really bad) (?:shortness of breath|breathlessness)\\b",
        "\\bgasping (?:for )?(?:air|breath)\\b",
        "\\b(?:ca(?:n ?'?t|not)|can hardly|can barely|hardly|barely|unable to|struggling to) (?:catch|get) my breath\\b",
        "\\bshort of breath (?:even )?(?:at rest|sitting|lying|when resting|while resting)\\b",
        "\\bchoking\\b"
      ]
    },
    {
      "id": "EM-BLEED",
      "category": "emergency",
      "spec": "FR-SAF-01",
      "patterns": [
        "\\b(?:bleeding|blood) (?:wo(?:n ?'?t|not)|will not|does(?:n ?'?t|not)|is(?:n ?'?t|not)) stop",
        "\\b(?:heavy|severe|a lot of|lots of|uncontrolled) bleeding\\b",
        "\\b(?:coughing|vomiting|throwing|spitting) (?:up )?blood\\b"
      ]
    },
    {
      "id": "EM-FAINT",
      "category": "emergency",
      "spec": "FR-SAF-01",
      "patterns": [
        "\\bfaint(?:ed|ing)\\b",
        "\\b(?:feel|feeling|felt|going to|about to|might) faint\\b",
        "\\bpass(?:ed|ing)? out\\b",
        "\\b(?:lost|losing) consciousness\\b",
        "\\b(?:collapsed|blacked out)\\b",
        "\\bunconscious\\b"
      ]
    },
    {
      "id": "EM-OVERDOSE",
      "category": "emergency",
      "spec": "FR-SAF-01/02",
      "patterns": [
        "\\boverdos(?:e|ed|ing)\\b",
        "\\btook (?:too many|a lot of|all (?:my|of my|the)|a whole (?:bottle|pack|strip) of) (?:pills|tablets|meds|medicines?|medication|insulin|sleeping pills)\\b"
      ]
    },
    {
      "id": "CR-SUICIDE",
      "category": "crisis",
      "spec": "FR-SAF-02",
      "patterns": [
        "\\bsuicid(?:e|al)\\b",
        "\\bkill(?:ing)? my ?self\\b",
        "\\bend(?:ing)? (?:my (?:own )?life|it all)\\b",
        "\\b(?:do(?:n ?'?t|not)|dont) want to (?:live|be alive|be here|exist|wake up)\\b",
        "\\bwant to die\\b",
        "\\bwish (?:i|i ?'?d) (?:was|were|had) (?:dead|never been born)\\b",
        "\\bbetter off (?:dead|without me)\\b",
        "\\bno (?:reason|point) (?:to|in) (?:live|living|going on)\\b",
        "\\btake my (?:own )?life\\b",
        "\\b(?:hurt|hurting|harm|harming|cut|cutting) my ?self\\b",
        "\\bself ?harm\\b",
        "\\bdisappear(?:ing)? (?:forever|for good|and never come back|and never coming back)\\b",
        "\\b(?:sleep|go to sleep|fall asleep) and never (?:wake|waking) up\\b",
        "\\b(?:never|not) (?:want to )?wake up again\\b",
        "\\b(?:give|giving|given|gave) away (?:all )?(?:of )?my (?:things|stuff|belongings|possessions)\\b"
      ]
    },
    {
      "id": "CR-HINGLISH",
      "category": "crisis",
      "spec": "FR-SAF-02, D-03",
      "note": "Common romanised Hindi phrases. DRAFT: needs review by a clinician fluent in Hindi.",
      "patterns": [
        "\\bmar(?:na|ne|jaana|jana) (?:chahta|chahti|chahte)\\b",
        "\\bkhud ?kushi\\b",
        "\\bjeena nahi? (?:chahta|chahti|hai)\\b",
        "\\bzinda nahi? (?:rehna|rahna)\\b"
      ]
    },
    {
      "id": "ED-RESTRICT",
      "category": "disordered_eating",
      "spec": "FR-SAF-04",
      "patterns": [
        "\\b[1-9][0-9]{1,2} (?:calories|cals|kcal|kcals) (?:a|per|each|every) day\\b",
        "\\b(?:eat|eating|have|having) only [1-9][0-9]{1,2} (?:calories|cals|kcal)\\b",
        "\\b(?:starve|starving) my ?self\\b",
        "\\b(?:stop|stopped|quit) eating (?:completely|entirely|altogether|for days)\\b",
        "\\b(?:have(?:n ?'?t|not)|havent|have not|not|did(?:n ?'?t|not)|didnt|did not) (?:eaten|eat|had (?:any )?food)(?: anything)? (?:in|for) (?:[2-9]|[1-9][0-9]|two|three|four|five|six|seven|several|a few|many) days\\b",
        "\\b(?:skip|skipping|skipped) (?:all|every) (?:of )?(?:my )?meals?\\b",
        "\\b(?:skip|skipping|not eating|no food|starv\\w*)\\b.*\\buntil i (?:drop|lose|fit|weigh|get down)\\b",
        "\\b(?:drop|lose|go down) (?:a|one|two|three|[1-9]) (?:dress |jean |clothes |pant )?sizes?\\b"
      ]
    },
    {
      "id": "ED-PURGE",
      "category": "disordered_eating",
      "spec": "FR-SAF-04",
      "patterns": [
        "\\b(?:make|making|made|force|forcing|forced) my ?self (?:to )?(?:throw up|vomit|be sick|sick|puke)\\b",
        "\\bpurg(?:ed|ing) (?:after|my|food|meals)\\b",
        "\\b(?:binge|binging|bingeing) (?:and|then) (?:purge|purging|throw up|vomit)\\b",
        "\\blaxatives? (?:to|for) (?:lose|losing|weight)\\b"
      ]
    },
    {
      "id": "ED-CRASH",
      "category": "disordered_eating",
      "spec": "FR-SAF-04",
      "patterns": [
        "\\blose weight (?:really |super |very |so )?fast\\b",
        "\\b(?:lose|drop) [0-9]+ ?(?:kg|kgs|kilos|kilograms|pounds|lbs) (?:in|by) (?:a|one|two|three|[0-9]+) (?:day|days|week|weeks)\\b",
        "\\b(?:hate|disgusted by|disgusted with) my (?:body|self)\\b"
      ]
    },
