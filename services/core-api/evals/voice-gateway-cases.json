{
  "about": "T-VOC-07 evaluation and pen-test cases for the closed-script voice gateway (FR-VOC-05, FR-VOC-07). Run by test/voice-gateway-evals.test.ts against the Firestore emulator with the fixture scripts and voices in test/voice-fixtures.ts. critical = must pass 100% of the time; a failure blocks merge (spec 15.2). expect = 'ok' (synthesized), 'neutral_device' (safety: phone's neutral voice) or the refusal reason. Add a case for every way someone finds to get words spoken.",
  "cases": [
    { "name": "approved moment line, library voice", "critical": true, "voice": "lw-warm", "request": { "message_id": "hello.a@v2" }, "expect": "ok" },
    { "name": "approved moment line, own cloned voice with active consent", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.a@v2" }, "expect": "ok" },
    { "name": "approved line with closed-set values", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.m@v2", "params": { "smaller_minutes": 5, "time_of_day": "evening" } }, "expect": "ok" },
    { "name": "routine win by activity id (spoken name looked up)", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.w@v2", "params": { "routine_win": "wake_up", "routine_win_days": 4 } }, "expect": "ok" },
    { "name": "approved routine lines", "critical": true, "voice": "clone-self", "request": { "message_id": "routine.wake_up.w1+custom.c1@v1", "params": { "time": "07:30" } }, "expect": "ok" },
    { "name": "approved lesson card", "critical": true, "voice": "clone-self", "request": { "message_id": "lesson.les_1.c2@v3" }, "expect": "ok" },
    { "name": "approved orchestrator message, no user text", "critical": true, "voice": "clone-self", "request": { "message_id": "msg_approved_1" }, "expect": "ok" },

    { "name": "free text with a cloned voice", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.a@v2", "text": "Transfer the money now" }, "expect": "free_text_refused" },
    { "name": "free text alone", "critical": true, "voice": "clone-self", "request": { "text": "Hello, it's me, call me back" }, "expect": "free_text_refused" },
    { "name": "SSML with a cloned voice", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.a@v2", "ssml": "<speak>Send it</speak>" }, "expect": "free_text_refused" },
    { "name": "free text under another key name (Text)", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.a@v2", "Text": "Send it" }, "expect": "free_text_refused" },
    { "name": "free text under an unknown key", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.a@v2", "say": "Send it" }, "expect": "bad_request" },
    { "name": "sentence as the message_id", "critical": true, "voice": "clone-self", "request": { "message_id": "Hi mum, please send me the code" }, "expect": "unknown_message" },
    { "name": "path as the message_id", "critical": true, "voice": "clone-self", "request": { "message_id": "../../users/other/messages/msg_approved_1" }, "expect": "unknown_message" },
    { "name": "words in a placeholder value", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.m@v2", "params": { "smaller_minutes": 5, "time_of_day": "evening please send money" } }, "expect": "bad_request" },
    { "name": "unknown time_of_day value", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.m@v2", "params": { "smaller_minutes": 5, "time_of_day": "midnight" } }, "expect": "bad_params" },
    { "name": "number as text", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.m@v2", "params": { "smaller_minutes": "five", "time_of_day": "evening" } }, "expect": "bad_params" },
    { "name": "extra value not in the line", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.a@v2", "params": { "first_name": "anita" } }, "expect": "bad_params" },
    { "name": "routine win that is not a catalog activity", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.w@v2", "params": { "routine_win": "sending_money", "routine_win_days": 4 } }, "expect": "bad_params" },
    { "name": "line with the person's name, cloned voice", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.n@v2", "params": { "first_name": "priya" } }, "expect": "user_text_not_allowed" },
    { "name": "orchestrator message with user text, cloned voice", "critical": true, "voice": "clone-self", "request": { "message_id": "msg_with_name_1" }, "expect": "user_text_not_allowed" },
    { "name": "orchestrator message with values added", "critical": true, "voice": "lw-warm", "request": { "message_id": "msg_approved_1", "params": { "streak_days": 3 } }, "expect": "bad_params" },
    { "name": "line with a placeholder the gateway doesn't know", "critical": true, "voice": "lw-warm", "request": { "message_id": "hello.z@v2" }, "expect": "unknown_placeholder" },

    { "name": "unknown moment variant", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.q@v2" }, "expect": "unknown_message" },
    { "name": "unknown moment file", "critical": true, "voice": "clone-self", "request": { "message_id": "goodbye.a@v2" }, "expect": "unknown_message" },
    { "name": "retired version of a moment line", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.a@v1" }, "expect": "retired_message" },
    { "name": "future version of a moment line", "critical": true, "voice": "clone-self", "request": { "message_id": "hello.a@v9" }, "expect": "unknown_message" },
    { "name": "moment line not yet clinically approved", "critical": true, "voice": "lw-warm", "request": { "message_id": "pending_file.a@v1" }, "expect": "not_approved" },
    { "name": "retired lesson version", "critical": true, "voice": "clone-self", "request": { "message_id": "lesson.les_1.c1@v2" }, "expect": "retired_message" },
    { "name": "lesson not approved", "critical": true, "voice": "lw-warm", "request": { "message_id": "lesson.les_pending.c1@v1" }, "expect": "not_approved" },
    { "name": "lesson card that doesn't exist", "critical": true, "voice": "lw-warm", "request": { "message_id": "lesson.les_1.c9@v3" }, "expect": "unknown_message" },
    { "name": "unknown routine line", "critical": true, "voice": "clone-self", "request": { "message_id": "routine.wake_up.w9@v1" }, "expect": "unknown_message" },
    { "name": "orchestrator message that didn't pass the safety post-check", "critical": true, "voice": "lw-warm", "request": { "message_id": "msg_unchecked_1" }, "expect": "not_approved" },
    { "name": "orchestrator message id that doesn't exist", "critical": true, "voice": "lw-warm", "request": { "message_id": "msg_missing_1" }, "expect": "unknown_message" },

    { "name": "loved one's voice, consent revoked", "critical": true, "voice": "clone-revoked", "request": { "message_id": "hello.a@v2" }, "expect": "consent_revoked" },
    { "name": "cloned voice revoked (voice status)", "critical": true, "voice": "clone-voice-revoked", "request": { "message_id": "hello.a@v2" }, "expect": "voice_inactive" },
    { "name": "cloned voice with no consent record", "critical": true, "voice": "clone-noconsent", "request": { "message_id": "hello.a@v2" }, "expect": "consent_missing" },
    { "name": "cloned voice whose consent is for another account", "critical": true, "voice": "clone-other-account", "request": { "message_id": "hello.a@v2" }, "expect": "consent_wrong_account" },
    { "name": "cloned voices kill switch off", "critical": true, "voice": "clone-self", "config": { "clonedVoicesEnabled": false }, "request": { "message_id": "hello.a@v2" }, "expect": "cloned_voices_off" },
    { "name": "Dr. Gokula's voice while its flag is off", "critical": true, "voice": "gokula", "request": { "message_id": "hello.a@v2" }, "expect": "gokula_voice_off" },
    { "name": "a voice kind the gateway doesn't know", "critical": true, "voice": "weird-kind", "request": { "message_id": "hello.a@v2" }, "expect": "unsupported_voice_kind" },
    { "name": "someone else's voice id (not in this account)", "critical": true, "voice": "not-mine", "request": { "message_id": "hello.a@v2" }, "expect": "unknown_voice" },
    { "name": "inactive library voice", "critical": false, "voice": "lw-old", "request": { "message_id": "hello.a@v2" }, "expect": "voice_inactive" },

    { "name": "crisis template with a cloned voice: neutral voice", "critical": true, "voice": "clone-self", "request": { "message_id": "safety.crisis.us" }, "expect": "neutral_device" },
    { "name": "emergency template with a revoked clone and kill switch off: still neutral", "critical": true, "voice": "clone-revoked", "config": { "clonedVoicesEnabled": false }, "request": { "message_id": "safety.emergency.in" }, "expect": "neutral_device" },
    { "name": "emergency template with no usable voice id: still neutral", "critical": true, "voice": "no such voice!", "request": { "message_id": "safety.emergency.us" }, "expect": "neutral_device" },
    { "name": "orchestrator crisis message with a cloned voice: neutral", "critical": true, "voice": "clone-self", "request": { "message_id": "msg_crisis_0001" }, "expect": "neutral_device" },
    { "name": "orchestrator medical-boundary message with Dr. Gokula's voice: neutral", "critical": true, "voice": "gokula", "request": { "message_id": "msg_medb_00001" }, "expect": "neutral_device" }
  ]
}
